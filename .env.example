# GYMSENSE Environment Configuration
# Copy to .env and customize for your environment.

GYMSENSE_APP_TITLE="AI Virtual Gym Trainer"
GYMSENSE_APP_ICON="💪"
GYMSENSE_LOG_LEVEL="INFO"

# MediaPipe PoseLandmarker model path and download URL
# GYMSENSE_MODEL_PATH="./pose_landmarker_lite.task"
GYMSENSE_MODEL_URL="https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task"

# WebRTC STUN server for browser camera streaming
GYMSENSE_STUN_URL="stun:stun.l.google.com:19302"

# Pose detection confidence thresholds (0.0 - 1.0)
GYMSENSE_MIN_DETECTION_CONFIDENCE=0.5
GYMSENSE_MIN_PRESENCE_CONFIDENCE=0.5
GYMSENSE_MIN_TRACKING_CONFIDENCE=0.5

# Max workout sessions kept in memory
GYMSENSE_HISTORY_LIMIT=50

# Support links in Streamlit menu
GYMSENSE_HELP_URL="https://github.com/Rebelgoldenjha/GymSensee"
GYMSENSE_ISSUES_URL="https://github.com/Rebelgoldenjha/GymSensee/issues"
